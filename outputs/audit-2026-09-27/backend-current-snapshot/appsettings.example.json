{
  "_comment": "Template. Copy to appsettings.Development.json for local dev (gitignored). In production use environment variables (see ops/linux/owl-api.env.example).",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TestMode": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5432;Database=owl_ai;Username=owl_ai;Password=CHANGE_ME"
  },
  "Jwt": {
    "Key": "CHANGE_ME_LONG_RANDOM_32_PLUS_BYTES",
    "Issuer": "https://api.mavrylo.com",
    "Audience": "flashcard-ai",
    "ExpiresMinutes": 10080,
    "DeviceExpiresMinutes": 60
  },
  "LegacyAuth": {
    "Enabled": false
  },
  "AiProtection": {
    "Enabled": true,
    "RequireAssertion": true,
    "FreeDailyQuota": 40
  },
  "AI": {
    "Provider": "OpenAI"
  },
  "AccountAi": {
    "DailyQuota": 200,
    "RequestsPerMinute": 30
  },
  "Gemini": {
    "ApiKey": "CHANGE_ME",
    "Model": "gemini-2.5-flash"
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-6-luna"
  },
  "Apple": {
    "ClientId": "com.mavrylo.owlai",
    "TeamId": "CHANGE_ME_TEAM_ID",
    "SkipSignatureValidation": false,
    "AppStoreServer": {
      "IssuerId": "CHANGE_ME_ISSUER_ID",
      "KeyId": "CHANGE_ME_KEY_ID",
      "BundleId": "com.mavrylo.owlai",
      "PrivateKeyPath": "/etc/owl-ai/secrets/SubscriptionKey.p8",
      "PrivateKey": "",
      "Environment": "Sandbox",
      "AllowedProductIds": "com.flashcardai.owlai.premium.monthly,com.flashcardai.owlai.premium.yearly",
      "BaseUrl": ""
    }
  },
  "Account": {
    "GoogleClientIds": "",
    "Audience": "owl-ai-account"
  },
  "Google": {
    "ClientIds": ""
  }
