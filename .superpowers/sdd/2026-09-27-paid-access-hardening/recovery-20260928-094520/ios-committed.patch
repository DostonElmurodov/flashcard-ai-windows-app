+        return !locksWordsBeyondFreeLimit(status: entitlement.effective(at: now).status)
+            || (zeroBasedIndex >= 0 && zeroBasedIndex < freeWordLimit)
     }
 
     /// Whether this entitlement keeps only the oldest `freeWordLimit` words active and locks the rest.
     ///
-    /// Applies to `expired_trial` (trialed, never paid) and `revoked` (paid then refunded/revoked):
-    /// both net out to $0 paid, so they are capped to the first 10 words just like a non-paying user.
-    /// Words beyond the first 10 become read-only and drop out of review/notifications/counts.
-    /// `expired_paid` (paid, simply lapsed) keeps **all** words active but read-only; `free`/`trial`/
-    /// `premium`/`grace` have full access.
+    /// Unvalidated/inactive states retain text while limiting review to the oldest ten.
+    /// Ordinary paid expiry retains the whole saved library. Linked-owner access remains
+    /// protected by account_required until its replacement proof contract exists.
     static func locksWordsBeyondFreeLimit(status: String) -> Bool {
-        !isTestModeEnabled && (status == "expired_trial" || status == "revoked")
+        !isTestModeEnabled && !["trial", "premium", "grace", "expired_paid", "account_required"].contains(status)
+    }
+
+    static func canEditWord(entitlement: EntitlementDTO, zeroBasedIndex: Int, now: Date = Date()) -> Bool {
+        if isTestModeEnabled { return true }
+        switch entitlement.effective(at: now).status {
+        case "trial", "premium", "grace": return true
+        case "free": return zeroBasedIndex >= 0 && zeroBasedIndex < freeWordLimit
+        default: return false
+        }
+    }
+}
+
+extension EntitlementDTO {
+    /// Local time can close access; it cannot grant an entitlement the server did not supply.
+    func effective(at now: Date) -> EntitlementDTO {
+        guard ["trial", "premium", "grace"].contains(status) else { return self }
+        let nextStatus: String
+        if let expiry = Self.parseExpiry(expiresAt) {
+            guard expiry <= now else { return self }
+            nextStatus = wasEverPaid ? "expired_paid" : "expired_trial"
+        } else {
+            nextStatus = "invalid_subscription"
+        }
+        return EntitlementDTO(status: nextStatus, productId: productId, expiresAt: expiresAt,
+            isTrial: isTrial, autoRenew: autoRenew, wasEverPaid: wasEverPaid,
+            resolutionSource: resolutionSource, purchaseIsLinked: purchaseIsLinked)
+    }
+
+    static func parseExpiry(_ value: String?) -> Date? {
+        guard let value, !value.isEmpty else { return nil }
+        let formatter = ISO8601DateFormatter()
+        formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        if let date = formatter.date(from: value) { return date }
+        formatter.formatOptions = [.withInternetDateTime]
+        return formatter.date(from: value)
     }
 }
