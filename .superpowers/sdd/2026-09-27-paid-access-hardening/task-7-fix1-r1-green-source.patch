+    [InlineData("inconsistent_total")]
+    [InlineData("oversized_output")]
+    [InlineData("overflow_output")]
+    public async Task GeminiZeroDefaultsDoNotForgiveUnknownOrInvalidUsage(string fault)
+    {
+        await ResetAsync(); await using var db = Database(); var body = JsonNode.Parse(GeminiZeroUsage)!.AsObject();
+        var usage = body["usageMetadata"]!.AsObject();
+        switch (fault)
