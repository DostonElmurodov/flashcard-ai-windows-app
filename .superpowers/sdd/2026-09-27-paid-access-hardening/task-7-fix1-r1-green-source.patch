+    [InlineData("missing_total")]
+    [InlineData("missing_prompt")]
+    [InlineData("missing_candidates")]
+    [InlineData("missing_model")]
+    [InlineData("missing_tier")]
+    [InlineData("unknown_model")]
+    [InlineData("unknown_tier")]
