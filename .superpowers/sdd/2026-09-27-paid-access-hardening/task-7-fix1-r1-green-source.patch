+    private const string GeminiZeroUsage = """{"modelVersion":"gemini-2.5-flash","usageMetadata":{"serviceTier":"standard","promptTokenCount":100,"candidatesTokenCount":10,"totalTokenCount":110},"candidates":[{"content":{"parts":[{"text":"{\"translation\":\"Hello\"}"}]}}]}""";
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task GeminiProtocolZeroComponentsSettleRepeatedSuccessesAndReleaseSlots(bool explicitZeros)
+    {
+        await ResetAsync(); await using var db = Database();
+        var body = JsonNode.Parse(GeminiZeroUsage)!;
+        if (explicitZeros)
+        {
+            body["usageMetadata"]!["thoughtsTokenCount"] = 0;
+            body["usageMetadata"]!["cachedContentTokenCount"] = 0;
+        }
+        var handler = new FakeHttpMessageHandler(_ => FakeHttpMessageHandler.Json(body.ToJsonString())); using var client = new HttpClient(handler);
+        var config = AiSpendTestSupport.Config(new() { ["AiSpend:MaxConcurrentAttempts"] = "1", ["AiSpend:DeadlineMilliseconds"] = "5000" });
+        var provider = new GeminiJsonService(config, AiSpendTestSupport.Transport(client, new AiSpendGuard(db, config, new Events())), NullLogger<GeminiJsonService>.Instance);
+        for (var call = 1; call <= 2; call++)
+        {
+            var result = await provider.CompleteJsonAsync("word-detail", "synthetic word");
+            Assert.Equal("Hello", result!.Value.GetProperty("translation").GetString());
+            var rows = await db.AiSpendReservations.AsNoTracking().ToListAsync();
+            Assert.Equal(call, rows.Count);
+            Assert.All(rows, row => { Assert.NotNull(row.SettledAt); Assert.Equal(99, row.ChargedMicroUsd); Assert.Equal(0, row.ReasoningTokens); Assert.Equal(0, row.CachedTokens); });
+            var bucket = await db.AiSpendBuckets.AsNoTracking().SingleAsync(x => x.Id == "global");
+            Assert.Equal(0, bucket.PendingAttempts); Assert.Equal(call * 99, bucket.ChargedMicroUsd);
+        }
+        Assert.Equal(2, handler.CapturedRequests.Count);
+    }
+
+    [Theory]
