+    private func reconciliationChainSource() -> FakeRestoreEvidenceSource {
+        let source = FakeRestoreEvidenceSource()
+        source.current = [ApplePurchaseEvidence(transactionId: "current-C",
+            originalTransactionId: "original-C", productId: StoreKitService.monthlyProductId,
+            jwsTransaction: "current-C-jws", jwsAppTransaction: "signed-app-transaction",
+            deviceVerificationId: deviceId)]
+        source.unfinished = [
+            ApplePurchaseEvidence(transactionId: "unfinished-A", originalTransactionId: "original-A",
+                productId: StoreKitService.monthlyProductId, jwsTransaction: "unfinished-A-jws",
+                jwsAppTransaction: "signed-app-transaction", deviceVerificationId: deviceId),
+            ApplePurchaseEvidence(transactionId: "unfinished-B", originalTransactionId: "original-B",
+                productId: StoreKitService.yearlyProductId, jwsTransaction: "unfinished-B-jws",
+                jwsAppTransaction: "signed-app-transaction", deviceVerificationId: deviceId)
+        ]
+        return source
+    }
+
+    private static func reconciliationChainReply(for jws: String) -> (Int, Data) {
+        switch jws {
+        case "current-C-jws":
+            return (200, response(status: "premium", authority: "mobile_restore"))
+        case "unfinished-A-jws":
+            return (503, Data(#"{"code":"subscription_reconciliation_required"}"#.utf8))
+        case "unfinished-B-jws":
+            return (200, response(status: "premium", authority: "mobile_restore",
+                productId: StoreKitService.yearlyProductId))
+        default:
+            XCTFail("Unexpected fake StoreKit evidence: \(jws)")
+            return (500, Data())
+        }
+    }
