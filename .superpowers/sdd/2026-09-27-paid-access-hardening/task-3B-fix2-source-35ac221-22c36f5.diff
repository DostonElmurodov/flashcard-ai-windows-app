+    @MainActor
+    func testNewerPendingProcessorStillAppliesAfterOlderDiscoveryEntersProcessorLate() async {
+        let source = FakeRestoreEvidenceSource()
+        let olderEnumerating = expectation(description: "Older Apple enumeration is held")
+        let newerAtBackend = expectation(description: "Newer processor has reached fake backend")
+        var releaseEnumeration: CheckedContinuation<[ApplePurchaseEvidence], Never>?
+        source.currentOperation = {
+            olderEnumerating.fulfill()
+            return await withCheckedContinuation { releaseEnumeration = $0 }
+        }
+        let (service, store, cleanup) = service(source: source)
+        defer { cleanup() }
+        let replies = DeferredRestoreHTTP()
+        RestoreProofURLProtocol.respondAsync = { request, reply in
+            XCTAssertEqual(request.url?.path, "/owlai/iap/restore")
+            replies.receive(reply, firstArrived: { newerAtBackend.fulfill() },
+                laterBody: Self.response(status: "expired_paid", authority: "mobile_restore"))
+        }
+        let olderEvidence = ApplePurchaseEvidence(transactionId: "older-A",
+            originalTransactionId: "original-A", productId: StoreKitService.monthlyProductId,
+            jwsTransaction: "older-jws", jwsAppTransaction: "signed-app-transaction",
+            deviceVerificationId: deviceId)
+        let newerEvidence = ApplePurchaseEvidence(transactionId: "newer-B",
+            originalTransactionId: "original-B", productId: StoreKitService.yearlyProductId,
+            jwsTransaction: "newer-jws", jwsAppTransaction: "signed-app-transaction",
+            deviceVerificationId: deviceId)
+        let older = Task { await service.discoverApplePurchases(explicitRestore: false) }
+        await fulfillment(of: [olderEnumerating], timeout: 2)
+        let newer = Task { try await service.processPurchaseEvidence(newerEvidence) }
+        await fulfillment(of: [newerAtBackend], timeout: 2)
+        guard let releaseEnumeration else {
+            XCTFail("Older enumeration did not install its fake release gate")
+            return
+        }
+        releaseEnumeration.resume(returning: [olderEvidence])
+        let olderAcknowledged = await older.value
+        XCTAssertTrue(olderAcknowledged)
+        XCTAssertEqual(store.entitlement.status, "expired_paid",
+            "The old history reply arrives before the newer premium reply")
+        guard replies.releaseFirst(status: 200,
+            body: Self.response(status: "premium", authority: "mobile_restore",
+                productId: StoreKitService.yearlyProductId)) else {
+            XCTFail("Newer processor did not install its fake backend reply gate")
+            return
+        }
+        do {
+            let outcome = try await newer.value
+            XCTAssertTrue(outcome.backendAcknowledged)
+            XCTAssertTrue(outcome.appliedToCurrentSession,
+                "Processor arrival order cannot discard newer captured authority")
+        } catch { XCTFail("Newer fake proof should be acknowledged: \(error)") }
+        XCTAssertEqual(Set(source.finished), Set(["older-A", "newer-B"]))
+        XCTAssertEqual(replies.requests, 2)
+        XCTAssertEqual(store.entitlement.status, "premium")
+        XCTAssertTrue(store.canUseAI)
+    }
