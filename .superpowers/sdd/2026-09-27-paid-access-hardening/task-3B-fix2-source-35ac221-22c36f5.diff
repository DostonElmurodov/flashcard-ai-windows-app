+    @MainActor
+    func testLateEnumerationErrorCannotPassAnAuthorityCheckSuspendedOnAccountGeneration() async {
+        let source = FakeRestoreEvidenceSource()
+        source.currentError = ApplePurchaseEvidenceError.unverifiedAppTransaction
+        let generation = UUID()
+        let olderCheckingGeneration = expectation(description: "Old error passed early authority check")
+        var generationCalls = 0
+        var releaseGeneration: CheckedContinuation<UUID, Never>?
+        let (service, store, cleanup) = service(source: source, accountSessionGeneration: {
+            generationCalls += 1
+            if generationCalls == 2 {
+                olderCheckingGeneration.fulfill()
+                return await withCheckedContinuation { releaseGeneration = $0 }
+            }
+            return generation
+        })
+        defer { cleanup() }
+        RestoreProofURLProtocol.respond = { request in
+            XCTAssertEqual(request.url?.path, "/owlai/iap/restore")
+            return (200, Self.response(status: "premium", authority: "mobile_restore"))
+        }
+        let older = Task { await service.discoverApplePurchases(explicitRestore: false) }
+        await fulfillment(of: [olderCheckingGeneration], timeout: 2)
+        let newer = try? await service.processPurchaseEvidence(evidence())
+        XCTAssertEqual(newer?.appliedToCurrentSession, true)
+        XCTAssertNil(service.errorText)
+        guard let releaseGeneration else {
+            XCTFail("Older error did not suspend at its final generation lookup")
+            return
+        }
+        releaseGeneration.resume(returning: generation)
+        let olderAcknowledged = await older.value
+        XCTAssertFalse(olderAcknowledged)
+        XCTAssertEqual(store.entitlement.status, "premium")
+        XCTAssertNil(service.errorText,
+            "The old error must recheck authority after its final account-generation await")
+    }
