+public class AiProviderBoundaryTests
+{
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task InvalidOutputJsonDoesNotLeakPrivateJsonPathsToAdapterLogger(bool gemini)
+    {
+        const string secret = "private-card-text-secret-token";
+        var text = "{\"" + secret + "\":@}";
+        var response = gemini ? System.Text.Json.JsonSerializer.Serialize(new { candidates = new[] { new { content = new { parts = new[] { new { text } } } } } })
+            : System.Text.Json.JsonSerializer.Serialize(new { output_text = text });
+        var handler = new FakeHttpMessageHandler(_ => FakeHttpMessageHandler.Json(response)); using var client = new HttpClient(handler);
+        var config = AiSpendTestSupport.Config(); var transport = AiSpendTestSupport.Transport(client);
