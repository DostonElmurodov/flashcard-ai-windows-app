diff --git a/tests/SubscriptionInventorySqlTests.cs b/tests/SubscriptionInventorySqlTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c5797563b1854c26218614c47583dc719cde5eb6
--- /dev/null
+++ b/tests/SubscriptionInventorySqlTests.cs
@@ -0,0 +1,169 @@
+using Npgsql;
+using System.Text.Json;
+using Mavrylo.Tests.TestSupport;
+using Xunit;
+
+namespace Mavrylo.Tests;
+
+public sealed class SubscriptionInventorySqlTests(PostgresContainerFixture postgres) : IClassFixture<PostgresContainerFixture>
+{
+    private static readonly string Sql = File.ReadAllText(Path.Combine(AppContext.BaseDirectory, "audit-subscription-state.sql"));
+
+    [Fact]
+    public async Task AggregateIsExactSafeAndRepeatableInReadOnlyTransaction()
+    {
+        await using var connection = new NpgsqlConnection(postgres.ConnectionString);
+        await connection.OpenAsync();
+        await SeedTemporaryTables(connection);
+        await using var transaction = await connection.BeginTransactionAsync();
+        await Execute(connection, transaction, "SET TRANSACTION READ ONLY");
+        await Execute(connection, transaction, "SET LOCAL owl.audit.expected_environment = 'Production'");
+        await Execute(connection, transaction, "SET LOCAL owl.audit.allowed_product_ids = ' product.one ,product.two '");
+        var first = await Report(connection, transaction);
+        var second = await Report(connection, transaction);
+        var output = SerializeReport(first);
+        Assert.Contains("\"Bucket\":\"TOTAL\"", output);
+        Assert.Contains("\"rows\":15", output);
+        Assert.Equal(output, SerializeReport(second));
+        Assert.DoesNotContain("id-a", output);
+        Assert.DoesNotContain("owner-a", output);
+        Assert.DoesNotContain("shared-ref", output);
+        var total = first.Single(x => x.Bucket == "TOTAL").Counts;
+        Assert.Equal(15, total["rows"]);
+        Assert.Equal(2, total["claimed"]);
+        Assert.Equal(9, total["unclaimed"]);
+        Assert.Equal(1, total["tombstoned"]);
+        Assert.Equal(3, total["inconsistent_claim"]);
+        Assert.Equal(1, total["orphan_owner"]);
+        Assert.Equal(4, total["invalid_original_id"]);
+        Assert.Equal(3, total["wrong_environment"]);
+        Assert.Equal(2, total["wrong_product"]);
+        Assert.Equal(1, total["null_expiry"]);
+        Assert.Equal(2, total["nonfinite_expiry"]);
+        Assert.Equal(2, total["out_of_dotnet_range_expiry"]);
+        Assert.Equal(2, total["duplicate_legacy_reference_rows"]);
+        Assert.Equal(2, total["mixed_claimed_legacy_reference_rows"]);
+        Assert.Equal(2, total["policy_applicable_rows"]);
+        Assert.Equal(1, first.Single(x => x.Bucket == "Sandbox").Counts["rows"]);
+        Assert.Equal(1, first.Single(x => x.Bucket == "LocalTesting").Counts["rows"]);
+        Assert.Equal(15L, await Scalar(connection, transaction, "SELECT count(*) FROM subscriptions"));
+        await transaction.CommitAsync();
+    }
+
+    [Theory]
+    [InlineData(null, null)]
+    [InlineData("", "product.one")]
+    [InlineData("Production ", "product.one")]
+    [InlineData("Wrong", "product.one")]
+    [InlineData("LocalTesting", "product.one")]
+    [InlineData("Production", "")]
+    [InlineData("Production", "product.one,")]
+    public async Task MissingOrInvalidTrustedSettingsFailClosed(string? environment, string? products)
+    {
+        await using var connection = new NpgsqlConnection(postgres.ConnectionString);
+        await connection.OpenAsync();
+        await SeedTemporaryTables(connection);
+        await using var transaction = await connection.BeginTransactionAsync();
+        await Execute(connection, transaction, "SET TRANSACTION READ ONLY");
+        if (environment is not null)
+        {
+            await using var setting = new NpgsqlCommand("SELECT set_config('owl.audit.expected_environment', @value, true)", connection, transaction);
+            setting.Parameters.AddWithValue("value", environment);
+            await setting.ExecuteNonQueryAsync();
+        }
+        if (products is not null)
+        {
+            await using var setting = new NpgsqlCommand("SELECT set_config('owl.audit.allowed_product_ids', @value, true)", connection, transaction);
+            setting.Parameters.AddWithValue("value", products);
+            await setting.ExecuteNonQueryAsync();
+        }
+        await Assert.ThrowsAnyAsync<Exception>(async () => await Report(connection, transaction));
+    }
+
+    [Fact]
+    public async Task EmptyTableStillValidatesSettingsAndReportsZero()
+    {
+        await using var connection = new NpgsqlConnection(postgres.ConnectionString);
+        await connection.OpenAsync();
+        await SeedTemporaryTables(connection, empty: true);
+        await using (var absent = await connection.BeginTransactionAsync())
+        {
+            await Execute(connection, absent, "SET TRANSACTION READ ONLY");
+            await Assert.ThrowsAnyAsync<Exception>(async () => await Report(connection, absent));
+        }
+        await using (var invalid = await connection.BeginTransactionAsync())
+        {
+            await Execute(connection, invalid, "SET TRANSACTION READ ONLY");
+            await Execute(connection, invalid, "SET LOCAL owl.audit.expected_environment = ''");
+            await Execute(connection, invalid, "SET LOCAL owl.audit.allowed_product_ids = 'product.one'");
+            await Assert.ThrowsAnyAsync<Exception>(async () => await Report(connection, invalid));
+        }
+        await using var valid = await connection.BeginTransactionAsync();
+        await Execute(connection, valid, "SET TRANSACTION READ ONLY");
+        await Execute(connection, valid, "SET LOCAL owl.audit.expected_environment = 'Production'");
+        await Execute(connection, valid, "SET LOCAL owl.audit.allowed_product_ids = 'product.one'");
+        var result = await Report(connection, valid);
+        Assert.Single(result);
+        Assert.Equal("TOTAL", result[0].Bucket);
+        Assert.All(result[0].Counts.Values, value => Assert.Equal(0, value));
+    }
+
+    private static async Task SeedTemporaryTables(NpgsqlConnection connection, bool empty = false)
+    {
+        await Execute(connection, null, """
+            CREATE TEMP TABLE "Users" ("Id" text);
+            CREATE TEMP TABLE subscriptions (
+              "OriginalTransactionId" text, "DeviceUuid" text, "OwnerAccountId" text,
+              "ClaimedAt" timestamptz, "Environment" text, "ProductId" text, "ExpiresAt" timestamptz);
+            """);
+        if (empty) return;
+        await Execute(connection, null, """
+            INSERT INTO "Users" VALUES ('owner-a'), ('owner-b');
+            INSERT INTO subscriptions VALUES
+              ('id-a', 'shared-ref', 'owner-a', now(), 'Production', 'product.one', now() + interval '1 day'),
+              ('id-b', 'other-ref', null, null, 'Sandbox', 'product.one', now() + interval '1 day'),
+              ('id-c', 'third-ref', null, now(), 'LocalTesting', 'product.one', now() + interval '1 day'),
+              ('id-d', 'd', null, null, 'Production', 'Product.one', now() + interval '1 day'),
+              ('id-e', 'e', null, null, ' Production', 'product.one', now() + interval '1 day'),
+              ('id-f', 'f', null, null, 'Production', 'product.one', null),
+              ('id-g', 'g', null, null, 'Production', 'product.one', 'infinity'),
+              ('id-h', 'h', null, null, 'Production', 'product.one', '-infinity'),
+              ('id-i', 'i', 'owner-a', null, 'Production', 'product.one', '10000-01-01'),
+              ('id-j', 'j', 'owner-a', null, 'Production', 'product.one', '0001-01-01 00:00:00+00'),
+              ('', 'k', 'ghost-owner', null, 'Production', 'product.one', now() + interval '1 day'),
+              (null, 'l', null, null, 'Production', ' product.one', now() + interval '1 day'),
+              ('id-m', 'shared-ref', 'owner-b', now(), 'Production', 'product.one', now() + interval '1 day'),
+              (E'\t\n', 'm', null, null, 'Production', 'product.one', now() + interval '1 day'),
+              (U&'\00A0', 'n', null, null, 'Production', 'product.one', now() + interval '1 day');
+            """);
+    }
+
+    private static async Task<long> Scalar(NpgsqlConnection conn, NpgsqlTransaction tx, string sql)
+    {
+        await using var command = new NpgsqlCommand(sql, conn, tx);
+        return Convert.ToInt64(await command.ExecuteScalarAsync());
+    }
+
+    private static async Task Execute(NpgsqlConnection conn, NpgsqlTransaction? tx, string sql)
+    {
+        await using var command = new NpgsqlCommand(sql, conn, tx);
+        await command.ExecuteNonQueryAsync();
+    }
+
+    private static async Task<List<(string Bucket, Dictionary<string, long> Counts)>> Report(NpgsqlConnection conn, NpgsqlTransaction tx)
+    {
+        await using var command = new NpgsqlCommand(Sql, conn, tx);
+        await using var reader = await command.ExecuteReaderAsync();
+        var rows = new List<(string Bucket, Dictionary<string, long> Counts)>();
+        while (await reader.ReadAsync())
+        {
+            var counts = new Dictionary<string, long>();
+            for (var i = 1; i < reader.FieldCount; i++) counts[reader.GetName(i)] = Convert.ToInt64(reader.GetValue(i));
+            rows.Add((reader.GetString(0), counts));
+        }
+        return rows;
+    }
+
+    private static string SerializeReport(List<(string Bucket, Dictionary<string, long> Counts)> rows)
+        => JsonSerializer.Serialize(rows.Select(row => new { row.Bucket, row.Counts }));
+}
