+        run: docker info
+      - name: Restore
+        run: dotnet restore tests/Mavrylo.Tests.csproj
+      - name: Build Release
+        run: dotnet build Mavrylo.csproj --configuration Release --no-restore
+      - name: Test Release
+        run: dotnet test tests/Mavrylo.Tests.csproj --configuration Release --no-restore
