+        var geminiLogger = new FallbackAiJsonServiceTests.CapturingLogger<GeminiJsonService>();
+        IAiJsonService provider = gemini ? new GeminiJsonService(config, transport, geminiLogger) : new OpenAiJsonService(config, transport, openLogger);
+        Assert.Null(await provider.CompleteJsonAsync("word-detail", "private-prompt"));
+        Assert.DoesNotContain(secret, string.Join("\n", openLogger.Lines.Concat(geminiLogger.Lines)));
+    }
+
+    [Fact]
+    public void MissingCacheWriteUsageCannotBecomeZeroCost()
+    {
+        using var document = System.Text.Json.JsonDocument.Parse("""{"model":"gpt-6-luna","service_tier":"default","usage":{"input_tokens":100,"output_tokens":10,"total_tokens":110,"input_tokens_details":{"cached_tokens":20},"output_tokens_details":{"reasoning_tokens":0}}}""");
+        Assert.Null(AiProviderTransport.ReadUsage("OpenAI", document.RootElement));
+    }
+    [Theory]
+    [InlineData(false, "prompt")]
+    [InlineData(true, "prompt")]
+    [InlineData(false, "image")]
+    [InlineData(true, "image")]
+    [InlineData(false, "model")]
+    [InlineData(true, "model")]
+    [InlineData(false, "operation")]
+    [InlineData(true, "profile")]
+    [InlineData(false, "context")]
+    [InlineData(true, "budget")]
+    [InlineData(false, "key")]
+    [InlineData(true, "key")]
+    public async Task UnsafeRequestNeverSubmitsOrFallsBack(bool gemini, string fault)
+    {
+        var handler = new FakeHttpMessageHandler(_ => FakeHttpMessageHandler.Json("{}")); using var client = new HttpClient(handler);
+        var config = AiSpendTestSupport.Config(); var guard = new AiSpendTestSupport.RecordingGuard { Deny = fault == "budget" };
+        if (fault == "model") config[gemini ? "Gemini:Model" : "OpenAI:Model"] = "unknown";
+        if (fault == "profile") config["AiSpend:PriceProfile"] = "unknown";
+        if (fault == "key") config[gemini ? "Gemini:ApiKey" : "OpenAI:ApiKey"] = "";
+        var transport = AiSpendTestSupport.Transport(client, guard, fault != "context");
+        IAiProviderJsonService primary = gemini ? new GeminiJsonService(config, transport, NullLogger<GeminiJsonService>.Instance)
+            : new OpenAiJsonService(config, transport, NullLogger<OpenAiJsonService>.Instance);
+        config["AI:Provider"] = primary.ProviderName;
+        var alerts = new NoAlert();
+        var service = new FallbackAiJsonService([primary], config, alerts, NullLogger<FallbackAiJsonService>.Instance);
+        await Assert.ThrowsAsync<AiSpendDeniedException>(() => fault == "image"
+            ? service.CompleteVisionJsonAsync("extract-words", "prompt", new byte[1025], "image/png")
+            : service.CompleteJsonAsync(fault == "operation" ? "unknown" : "word-detail", fault == "prompt" ? new string('x', 16001) : "prompt"));
+        Assert.Empty(handler.CapturedRequests); Assert.Equal(0, alerts.Calls);
+    }
+
+    [Theory]
+    [InlineData(false, false)]
+    [InlineData(true, false)]
+    [InlineData(false, true)]
+    [InlineData(true, true)]
+    public async Task KnownAndUnknownLengthOversizeResponsesRemainReserved(bool gemini, bool knownLength)
+    {
+        var handler = new FakeHttpMessageHandler(_ => new(HttpStatusCode.OK)
+        { Content = knownLength ? new StringContent(new string('x', 500)) : new StreamContent(new NonSeekable(new MemoryStream(Encoding.UTF8.GetBytes(new string('x', 500))))) });
+        using var client = new HttpClient(handler); var config = AiSpendTestSupport.Config(new() { ["AiSpend:MaxResponseBytes"] = "100" });
+        var guard = new AiSpendTestSupport.RecordingGuard();
+        var transport = AiSpendTestSupport.Transport(client, guard);
+        IAiJsonService provider = gemini ? new GeminiJsonService(config, transport, NullLogger<GeminiJsonService>.Instance)
+            : new OpenAiJsonService(config, transport, NullLogger<OpenAiJsonService>.Instance);
+        await Assert.ThrowsAsync<AiProviderException>(() => provider.CompleteJsonAsync("word-detail", "prompt"));
+        Assert.Single(handler.CapturedRequests); Assert.Single(guard.Completions); Assert.Null(guard.Completions[0]);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task SlowBodyHonorsFullDeadlineAsTerminalUnavailable(bool gemini)
+    {
+        var handler = new FakeHttpMessageHandler(_ => new(HttpStatusCode.OK) { Content = new StreamContent(new SlowStream()) });
+        using var client = new HttpClient(handler); var config = AiSpendTestSupport.Config(new() { ["AiSpend:DeadlineMilliseconds"] = "80" });
+        var guard = new AiSpendTestSupport.RecordingGuard(); var transport = AiSpendTestSupport.Transport(client, guard);
+        IAiProviderJsonService provider = gemini ? new GeminiJsonService(config, transport, NullLogger<GeminiJsonService>.Instance)
+            : new OpenAiJsonService(config, transport, NullLogger<OpenAiJsonService>.Instance);
+        config["AI:Provider"] = provider.ProviderName;
+        var alerts = new NoAlert(); var service = new FallbackAiJsonService([provider], config, alerts, NullLogger<FallbackAiJsonService>.Instance);
+        var error = await Assert.ThrowsAsync<AiSpendDeniedException>(() => service.CompleteJsonAsync("word-detail", "prompt"));
+        Assert.Equal("provider_deadline", error.Reason);
+        Assert.Equal(0, alerts.Calls); Assert.Null(Assert.Single(guard.Completions));
+    }
+
+    [Fact]
+    public async Task ReservationDeadlineIsTerminalBeforeHttp()
+    {
+        var handler = new FakeHttpMessageHandler(_ => FakeHttpMessageHandler.Json("{}")); using var client = new HttpClient(handler);
+        var config = AiSpendTestSupport.Config(new() { ["AiSpend:DeadlineMilliseconds"] = "80" });
+        var provider = new OpenAiJsonService(config, AiSpendTestSupport.Transport(client, new StalledGuard()), NullLogger<OpenAiJsonService>.Instance);
+        var alerts = new NoAlert(); var service = new FallbackAiJsonService([provider], config, alerts, NullLogger<FallbackAiJsonService>.Instance);
+        var error = await Assert.ThrowsAsync<AiSpendDeniedException>(() => service.CompleteJsonAsync("word-detail", "prompt"));
+        Assert.Equal("provider_deadline", error.Reason); Assert.Empty(handler.CapturedRequests); Assert.Equal(0, alerts.Calls);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task MalformedJsonRetainsUnknownReservation(bool gemini)
+    {
+        var handler = new FakeHttpMessageHandler(_ => FakeHttpMessageHandler.Json("{not-json")); using var client = new HttpClient(handler);
+        var guard = new AiSpendTestSupport.RecordingGuard(); var transport = AiSpendTestSupport.Transport(client, guard); var config = AiSpendTestSupport.Config();
+        IAiJsonService provider = gemini ? new GeminiJsonService(config, transport, NullLogger<GeminiJsonService>.Instance)
+            : new OpenAiJsonService(config, transport, NullLogger<OpenAiJsonService>.Instance);
+        await Assert.ThrowsAnyAsync<System.Text.Json.JsonException>(() => provider.CompleteJsonAsync("word-detail", "prompt"));
+        Assert.Null(Assert.Single(guard.Completions));
+    }
+
+    [Fact]
+    public void KnownModelCeilingsRoundUpAndGeminiUsageIncludesThoughtsExactlyOnce()
+    {
+        var config = AiSpendTestSupport.Config();
+        Assert.Equal(578345, AiCostProfile.Read(config, "OpenAI", "gpt-6-luna", "word-detail", "prompt", null, null).ReservationMicroUsd);
+        Assert.Equal(568536, AiCostProfile.Read(config, "Gemini", "gemini-2.5-flash", "word-detail", "prompt", null, null).ReservationMicroUsd);
+        using var doc = System.Text.Json.JsonDocument.Parse("""{"modelVersion":"gemini-2.5-flash","usageMetadata":{"serviceTier":"standard","promptTokenCount":100,"cachedContentTokenCount":30,"candidatesTokenCount":10,"thoughtsTokenCount":7,"totalTokenCount":117}}""");
+        var usage = AiProviderTransport.ReadUsage("Gemini", doc.RootElement);
+        Assert.NotNull(usage); Assert.Equal(100, usage.Input); Assert.Equal(17, usage.Output); Assert.Equal(7, usage.Reasoning); Assert.Equal(30, usage.Cached);
+    }
+
+    internal sealed class NoAlert : IDevAlertEmailService
+    {
+        public int Calls { get; private set; }
+        public Task NotifyAiProvidersFailedAsync(string operationName, string requestPath, IReadOnlyList<AiProviderFailure> failures, CancellationToken ct = default)
+        { Calls++; return Task.CompletedTask; }
+    }
+    internal class NonSeekable(Stream source) : Stream
+    {
+        public override bool CanRead => true; public override bool CanSeek => false; public override bool CanWrite => false;
+        public override long Length => throw new NotSupportedException(); public override long Position { get => throw new NotSupportedException(); set => throw new NotSupportedException(); }
+        public override int Read(byte[] buffer, int offset, int count) => source.Read(buffer, offset, count);
+        public override ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken ct = default) => source.ReadAsync(buffer, ct);
+        protected override void Dispose(bool disposing) { if (disposing) source.Dispose(); base.Dispose(disposing); }
+        public override void Flush() => throw new NotSupportedException(); public override long Seek(long offset, SeekOrigin origin) => throw new NotSupportedException();
+        public override void SetLength(long value) => throw new NotSupportedException(); public override void Write(byte[] buffer, int offset, int count) => throw new NotSupportedException();
+    }
+    internal sealed class SlowStream() : NonSeekable(Stream.Null)
+    {
+        public override async ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken ct = default) { await Task.Delay(Timeout.Infinite, ct); return 0; }
+    }
+    private sealed class StalledGuard : IAiSpendGuard
+    {
+        public async Task<SpendReservation?> TryReserveAsync(AiAttempt attempt, CancellationToken ct)
+        { await Task.Delay(Timeout.Infinite, ct); return null; }
+        public Task CompleteAsync(Guid reservationId, AiAttemptUsage? usage, CancellationToken ct) => throw new InvalidOperationException("No reservation was returned.");
+    }
+}
