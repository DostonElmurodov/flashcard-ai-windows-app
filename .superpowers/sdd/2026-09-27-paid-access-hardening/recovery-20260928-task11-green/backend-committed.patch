+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using Mavrylo.Services;
+using Mavrylo.Tests.TestSupport;
+using Microsoft.AspNetCore.Http;
+using Microsoft.Extensions.DependencyInjection;
+using Xunit;
+
+namespace Mavrylo.Tests;
+
+public class AiProviderTransportTests(PostgresContainerFixture postgres) : IClassFixture<PostgresContainerFixture>
+{
+    [Fact]
+    public async Task CallerCancellationDuringConnectionStaysCancellation()
+    {
+        using var handler = AiProviderTransport.CreateHandler();
+        var started = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        handler.ConnectCallback = async (_, ct) => { started.SetResult(); await Task.Delay(Timeout.Infinite, ct); return Stream.Null; };
+        using var client = new HttpClient(handler) { Timeout = Timeout.InfiniteTimeSpan };
+        var guard = new AiSpendTestSupport.RecordingGuard(); var transport = AiSpendTestSupport.Transport(client, guard);
+        var profile = AiCostProfile.Read(AiSpendTestSupport.Config(new() { ["AiSpend:DeadlineMilliseconds"] = "5000" }), "Gemini", "gemini-2.5-flash", "word-detail", "prompt", null, null);
+        using var caller = new CancellationTokenSource();
+        using var request = new HttpRequestMessage(HttpMethod.Post, "http://127.0.0.1/") { Content = new StringContent("{}") };
+        var attempt = transport.SendAsync(profile, "word-detail", request, caller.Token);
+        await started.Task.WaitAsync(TimeSpan.FromSeconds(2)); caller.Cancel();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => attempt);
+        Assert.Single(guard.Attempts); Assert.Null(Assert.Single(guard.Completions));
+    }
+
+    [Theory]
+    [InlineData("disconnect")]
+    [InlineData("redirect")]
+    [InlineData("chunked")]
+    [InlineData("slow")]
+    public async Task RegisteredHandlerSubmitsExactlyOneBoundedPost(string mode)
+    {
+        await using var factory = new ApiFactory(postgres.ConnectionString);
+        _ = factory.CreateClient(); // Resolve the actual application's named client registration.
+        using var server = new Loopback(mode);
+        var guard = new AiSpendTestSupport.RecordingGuard();
+        var http = new DefaultHttpContext(); AiSpendContext.AuthorizeAcceptedRequest(http, null, "authenticated-loopback");
+        var transport = new AiProviderTransport(factory.Services.GetRequiredService<IHttpClientFactory>(), guard,
+            new(new HttpContextAccessor { HttpContext = http }), new AiSpendGuardTests.Events());
+        var config = AiSpendTestSupport.Config(new() { ["AiSpend:DeadlineMilliseconds"] = "500", ["AiSpend:MaxResponseBytes"] = "100" });
+        var profile = AiCostProfile.Read(config, "Gemini", "gemini-2.5-flash", "word-detail", "prompt", null, null);
+        using var request = new HttpRequestMessage(HttpMethod.Post, server.Url) { Content = new StringContent("{}", Encoding.UTF8, "application/json") };
+        request.Headers.Add("x-goog-api-key", "loopback-only-secret");
+        var error = await Record.ExceptionAsync(() => transport.SendAsync(profile, "word-detail", request, default));
+        Assert.NotNull(error);
+        if (mode == "slow") Assert.Equal("provider_deadline", Assert.IsType<AiSpendDeniedException>(error).Reason);
+        if (mode == "redirect") Assert.Equal(307, Assert.IsType<AiProviderException>(error).StatusCode);
+        await Task.Delay(100); // A bounded observation for unexpected automatic retries/redirects.
+        Assert.Equal(1, server.Submissions);
+        Assert.Contains("POST / HTTP/1.1", server.LastHeaders);
+        Assert.DoesNotContain("Expect:", server.LastHeaders, StringComparison.OrdinalIgnoreCase);
+        Assert.Single(guard.Attempts); Assert.Null(Assert.Single(guard.Completions));
+    }
+
+    [Fact]
+    public async Task PooledConnectionDisconnectAfterPostDoesNotResubmit()
+    {
+        await using var factory = new ApiFactory(postgres.ConnectionString); _ = factory.CreateClient();
+        using var server = new Loopback("pooled"); var guard = new AiSpendTestSupport.RecordingGuard();
+        var http = new DefaultHttpContext(); AiSpendContext.AuthorizeAcceptedRequest(http, null, "authenticated-loopback");
+        var transport = new AiProviderTransport(factory.Services.GetRequiredService<IHttpClientFactory>(), guard,
+            new(new HttpContextAccessor { HttpContext = http }), new AiSpendGuardTests.Events());
+        var profile = AiCostProfile.Read(AiSpendTestSupport.Config(), "OpenAI", "gpt-6-luna", "word-detail", "prompt", null, null);
+        using var first = new HttpRequestMessage(HttpMethod.Post, server.Url) { Content = new StringContent("{}") };
+        using var document = await transport.SendAsync(profile, "word-detail", first, default);
+        using var second = new HttpRequestMessage(HttpMethod.Post, server.Url) { Content = new StringContent("{}") };
+        await Assert.ThrowsAsync<HttpRequestException>(() => transport.SendAsync(profile, "word-detail", second, default));
+        await Task.Delay(100);
+        Assert.Equal(2, server.Submissions); Assert.Equal(1, server.Connections); Assert.Equal(2, guard.Attempts.Count);
+    }
+
+    private sealed class Loopback : IDisposable
+    {
+        private readonly TcpListener listener = new(IPAddress.Loopback, 0);
+        private readonly CancellationTokenSource stopped = new();
+        private readonly Task serving;
+        private int submissions, connections;
+        public int Submissions => Volatile.Read(ref submissions);
+        public int Connections => Volatile.Read(ref connections);
+        public string LastHeaders { get; private set; } = "";
+        public string Url { get; }
+        public Loopback(string mode)
+        {
+            listener.Start(); Url = $"http://127.0.0.1:{((IPEndPoint)listener.LocalEndpoint).Port}/";
+            serving = Serve(mode);
+        }
+        private async Task Serve(string mode)
+        {
+            try
+            {
+                while (!stopped.IsCancellationRequested)
+                {
+                    using var socket = await listener.AcceptTcpClientAsync(stopped.Token); Interlocked.Increment(ref connections);
+                    var stream = socket.GetStream();
+                    await ReadPost(stream);
+                    if (mode == "disconnect") continue;
+                    if (mode == "pooled")
+                    {
+                        await Write(stream, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\n{}");
+                        await ReadPost(stream); continue;
+                    }
+                    if (mode == "redirect") await Write(stream, $"HTTP/1.1 307 Temporary Redirect\r\nLocation: {Url}target\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
+                    if (mode == "chunked") await Write(stream, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n200\r\n" + new string('x', 512) + "\r\n0\r\n\r\n");
+                    if (mode == "slow")
+                    {
+                        await Write(stream, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n");
+                        await Task.Delay(Timeout.Infinite, stopped.Token);
+                    }
+                }
+            }
+            catch (OperationCanceledException) { }
+            catch (IOException) when (stopped.IsCancellationRequested) { }
+            catch (SocketException) when (stopped.IsCancellationRequested) { }
+        }
+        private async Task ReadPost(NetworkStream stream)
+        {
+            using var header = new MemoryStream(); var one = new byte[1];
+            while (header.Length < 32768)
+            {
+                if (await stream.ReadAsync(one, stopped.Token) == 0) throw new IOException("Connection closed before request.");
+                header.WriteByte(one[0]);
+                if (header.Length >= 4 && Encoding.ASCII.GetString(header.GetBuffer(), (int)header.Length - 4, 4) == "\r\n\r\n") break;
+            }
+            LastHeaders = Encoding.ASCII.GetString(header.ToArray());
+            var length = int.Parse(LastHeaders.Split("\r\n").Single(x => x.StartsWith("Content-Length:", StringComparison.OrdinalIgnoreCase)).Split(':')[1]);
+            var body = new byte[length]; await stream.ReadExactlyAsync(body, stopped.Token);
+            Interlocked.Increment(ref submissions);
+        }
+        private Task Write(NetworkStream stream, string content) => stream.WriteAsync(Encoding.ASCII.GetBytes(content), stopped.Token).AsTask();
+        public void Dispose()
+        {
+            stopped.Cancel(); listener.Stop(); serving.GetAwaiter().GetResult(); stopped.Dispose();
+        }
+    }
+}
