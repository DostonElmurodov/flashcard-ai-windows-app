index 0000000000000000000000000000000000000000..3bb7a33a2df908ccca4d9d14ac17338c4611339e
--- /dev/null
+++ b/ops/audit-subscription-state.sql
@@ -0,0 +1,80 @@
+-- Read-only aggregate of the CURRENT subscriptions/"Users" schema. Run against a
+-- separately authorized database after setting these two trusted session settings:
+--   SET owl.audit.expected_environment = 'Production'; -- or 'Sandbox'
+--   SET owl.audit.allowed_product_ids = 'product.one,product.two';
+-- Use a read-only transaction/role and verify the deployed version first. The report
+-- deliberately emits no transaction/device/account IDs, receipts, or personal text.
+-- LocalTesting/Xcode are counted as historical buckets, never a trusted target
+-- for this non-Development deployment audit. A missing, blank or unsupported
+-- expected environment, or an empty product list,
+-- raises an error instead of treating the database as safe.
+WITH dotnet_whitespace AS MATERIALIZED (
+    SELECT U&'\0009\000A\000B\000C\000D\0020\0085\00A0\1680\2000\2001\2002\2003\2004\2005\2006\2007\2008\2009\200A\2028\2029\202F\205F\3000' AS chars
+), audit_config AS MATERIALIZED (
+    SELECT current_setting('owl.audit.expected_environment') AS expected_environment,
+           string_to_array(current_setting('owl.audit.allowed_product_ids'), ',') AS raw_products
+), trusted AS MATERIALIZED (
+    SELECT expected_environment,
+           ARRAY(SELECT btrim(p, w.chars) FROM unnest(raw_products) AS p WHERE btrim(p, w.chars) <> '') AS products,
+           CASE WHEN expected_environment COLLATE "C" IN ('Production', 'Sandbox')
+                     AND expected_environment = btrim(expected_environment, w.chars)
+                     AND array_length(raw_products, 1) > 0
+                     AND NOT EXISTS (SELECT 1 FROM unnest(raw_products) AS p WHERE btrim(p, w.chars) = '')
+                THEN 1 ELSE ('Invalid trusted audit environment/products (' || length(expected_environment) || ')')::integer END AS valid
+    FROM audit_config CROSS JOIN dotnet_whitespace w
+), legacy_refs AS (
+    SELECT "DeviceUuid", count(*) AS rows_in_group,
+           count(DISTINCT "OwnerAccountId") FILTER (WHERE "ClaimedAt" IS NOT NULL) AS claimed_accounts
+    FROM subscriptions
+    WHERE "DeviceUuid" IS NOT NULL AND btrim("DeviceUuid", (SELECT chars FROM dotnet_whitespace)) <> ''
+    GROUP BY "DeviceUuid"
+), classified AS (
+    SELECT CASE WHEN s."Environment" COLLATE "C" = 'Production' THEN 'Production'
+                WHEN s."Environment" COLLATE "C" = 'Sandbox' THEN 'Sandbox'
+                WHEN s."Environment" COLLATE "C" = 'LocalTesting' THEN 'LocalTesting'
+                WHEN s."Environment" COLLATE "C" = 'Xcode' THEN 'Xcode'
+                ELSE 'OtherOrBlank' END AS environment_bucket,
+           s."OwnerAccountId" IS NOT NULL AND s."ClaimedAt" IS NOT NULL AS claimed,
+           s."OwnerAccountId" IS NULL AND s."ClaimedAt" IS NULL AS unclaimed,
+           s."OwnerAccountId" IS NULL AND s."ClaimedAt" IS NOT NULL AS tombstoned,
+           s."OwnerAccountId" IS NOT NULL AND s."ClaimedAt" IS NULL AS inconsistent_claim,
+           s."OwnerAccountId" IS NOT NULL AND u."Id" IS NULL AS orphan_owner,
+           s."OriginalTransactionId" IS NULL OR btrim(s."OriginalTransactionId", w.chars) = '' AS invalid_original_id,
+           s."Environment" IS NULL OR s."Environment" COLLATE "C" <> t.expected_environment COLLATE "C" AS wrong_environment,
+           s."ProductId" IS NULL OR NOT (s."ProductId" COLLATE "C" = ANY(t.products)) AS wrong_product,
+           s."ExpiresAt" IS NULL AS null_expiry,
+           s."ExpiresAt" IS NOT NULL AND NOT isfinite(s."ExpiresAt") AS nonfinite_expiry,
+           s."ExpiresAt" IS NOT NULL AND isfinite(s."ExpiresAt")
+               AND (s."ExpiresAt" <= TIMESTAMPTZ '0001-01-01 00:00:00+00'
+                    OR s."ExpiresAt" >= TIMESTAMPTZ '10000-01-01 00:00:00+00') AS out_of_dotnet_range_expiry,
+           r.rows_in_group > 1 AS duplicate_legacy_reference,
+           r.rows_in_group > 1 AND r.claimed_accounts > 1 AS mixed_claimed_legacy_reference
+    FROM subscriptions s
+    CROSS JOIN trusted t
+    CROSS JOIN dotnet_whitespace w
+    LEFT JOIN "Users" u ON u."Id" = s."OwnerAccountId"
+    LEFT JOIN legacy_refs r ON r."DeviceUuid" = s."DeviceUuid"
+    WHERE t.valid = 1
+), report AS (
+    SELECT coalesce(environment_bucket, 'TOTAL') AS environment_bucket,
+           count(*) AS rows,
+           count(*) FILTER (WHERE claimed) AS claimed,
+           count(*) FILTER (WHERE unclaimed) AS unclaimed,
+           count(*) FILTER (WHERE tombstoned) AS tombstoned,
+           count(*) FILTER (WHERE inconsistent_claim) AS inconsistent_claim,
+           count(*) FILTER (WHERE orphan_owner) AS orphan_owner,
+           count(*) FILTER (WHERE invalid_original_id) AS invalid_original_id,
+           count(*) FILTER (WHERE wrong_environment) AS wrong_environment,
+           count(*) FILTER (WHERE wrong_product) AS wrong_product,
+           count(*) FILTER (WHERE null_expiry) AS null_expiry,
+           count(*) FILTER (WHERE nonfinite_expiry) AS nonfinite_expiry,
+           count(*) FILTER (WHERE out_of_dotnet_range_expiry) AS out_of_dotnet_range_expiry,
+           count(*) FILTER (WHERE duplicate_legacy_reference) AS duplicate_legacy_reference_rows,
+           count(*) FILTER (WHERE mixed_claimed_legacy_reference) AS mixed_claimed_legacy_reference_rows,
+           count(*) FILTER (WHERE NOT (invalid_original_id OR wrong_environment OR wrong_product
+               OR null_expiry OR nonfinite_expiry OR out_of_dotnet_range_expiry)) AS policy_applicable_rows
+    FROM classified GROUP BY ROLLUP(environment_bucket)
+)
+SELECT r.* FROM report r CROSS JOIN trusted t
+WHERE t.valid = 1
+ORDER BY environment_bucket;
