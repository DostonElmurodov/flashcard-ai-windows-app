+public sealed class PaidAccessJsonAuditRegressionTests(PostgresContainerFixture postgres) : IClassFixture<PostgresContainerFixture>
+{
+    [Theory]
+    [InlineData("word", "word-detail")]
+    [InlineData("Word", "word-detail")]
