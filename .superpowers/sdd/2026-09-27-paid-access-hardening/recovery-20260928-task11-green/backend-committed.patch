+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Mavrylo.Data;
+using Mavrylo.Models;
+using Mavrylo.Services;
+using Mavrylo.Tests.TestSupport;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Xunit;
+
+namespace Mavrylo.Tests;
+
+public sealed class TestModeHostBoundaryTests(PostgresContainerFixture postgres) : IClassFixture<PostgresContainerFixture>
+{
+    private static readonly Dictionary<string, string?> SignedSandbox = new()
+    {
+        ["AccountAi:DailyQuota"] = "1", ["AccountAi:RequestsPerMinute"] = "1",
+        ["AiProtection:Enabled"] = "true", ["AiProtection:RequireAssertion"] = "true",
+        ["Apple:SkipSignatureValidation"] = "false",
+        ["Apple:ClientId"] = "com.example.test", ["Apple:TeamId"] = "FAKETEAM",
+        ["Apple:AppStoreServer:BundleId"] = "com.example.test",
+        ["Apple:AppStoreServer:Environment"] = "Sandbox",
+        ["Apple:AppStoreServer:AllowedProductIds"] = "com.example.monthly",
+        ["Jwt:DeviceExpiresMinutes"] = "30"
+    };
+
+    private ApiFactory Factory(string host, bool testMode, string? connectionString = null)
+    {
+        var config = new Dictionary<string, string?>(SignedSandbox) { ["TestMode:Enabled"] = testMode.ToString() };
+        return new ApiFactory(connectionString ?? postgres.ConnectionString, configurationOverrides: config, environment: host);
+    }
+
+    [Theory]
+    [InlineData("Production")]
+    [InlineData("Staging")]
+    public void NonDevelopmentTrueFailsSpecificallyBeforeMigration(string host)
+    {
+        // The guard must fail before Program attempts Database.MigrateAsync.
+        using var factory = Factory(host, true, "Host=127.0.0.1;Port=1;Database=unreachable;Username=none;Timeout=1");
+        var error = Assert.Throws<InvalidOperationException>(() => factory.CreateClient());
+        Assert.Contains("TestMode:Enabled", error.ToString());
+    }
+
+    [Fact]
+    public async Task SignedSandboxFalseRemainsUsableAndReloadCannotEnableTestMode()
+    {
+        await using var factory = Factory("Production", false);
+        using var client = factory.CreateClient();
+        Assert.False((await client.GetFromJsonAsync<JsonElement>("/owlai/config/feature-flags")).GetProperty("test_mode").GetBoolean());
+
+        using var scope = factory.Services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        var words = scope.ServiceProvider.GetRequiredService<DeviceWordService>();
+        var usage = scope.ServiceProvider.GetRequiredService<AccountAiUsageService>();
+        var account = "runtime-test-" + Guid.NewGuid().ToString("N");
+        Assert.True(await usage.TryConsumeAsync(account, default));
+        Assert.False(await usage.TryConsumeAsync(account, default));
+        var config = factory.Services.GetRequiredService<IConfiguration>();
+        config["TestMode:Enabled"] = "true";
+        Assert.False((await client.GetFromJsonAsync<JsonElement>("/owlai/config/feature-flags")).GetProperty("test_mode").GetBoolean());
+        Assert.False(await usage.TryConsumeAsync(account, default));
+        var session = await scope.ServiceProvider.GetRequiredService<AccountService>()
+            .SignInAsync(new("reload-owner-" + Guid.NewGuid().ToString("N"), null, "Tester"), default, allowCreation: true);
+        client.DefaultRequestHeaders.Authorization = new("Bearer", session.AccessToken);
+        Assert.Equal(HttpStatusCode.PaymentRequired,
+            (await client.PostAsJsonAsync("/owlai/account/ai/analyze-word", new { word = "valid-word" })).StatusCode);
+        for (var i = 0; i < 10; i++)
+            Assert.True((await words.UpsertAsync("runtime-device", new(null, "word-" + i, "word-" + i, "", "en", "es", null, null, null), "free", default)).Accepted);
+        Assert.False((await words.UpsertAsync("runtime-device", new(null, "eleventh", "eleventh", "", "en", "es", null, null, null), "free", default)).Accepted);
+        Assert.Equal(10, await db.DeviceWords.CountAsync(x => x.DeviceUuid == "runtime-device"));
+    }
+
+    [Fact]
+    public async Task DevelopmentCanEnableAfterStartup()
+    {
+        await using var factory = Factory("Development", false);
+        using var client = factory.CreateClient();
+        factory.Services.GetRequiredService<IConfiguration>()["TestMode:Enabled"] = "true";
+        Assert.True((await client.GetFromJsonAsync<JsonElement>("/owlai/config/feature-flags")).GetProperty("test_mode").GetBoolean());
+    }
+}
