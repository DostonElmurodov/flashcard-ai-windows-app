diff --git a/src/Mavrylo.Services/Services/AiCostProfile.cs b/src/Mavrylo.Services/Services/AiCostProfile.cs
new file mode 100644
index 0000000000000000000000000000000000000000..d0463592b74edb812017359bacf3dc0b274d3aa6
--- /dev/null
+++ b/src/Mavrylo.Services/Services/AiCostProfile.cs
@@ -0,0 +1,64 @@
+namespace Mavrylo.Services;
+
+/// <summary>Immutable reviewed price envelope. Rates are integer nano-USD per token.</summary>
+public sealed record AiCostProfile
+{
+    // Only the server's reviewed factory can expose a profile to other application assemblies.
+    internal AiCostProfile(string id, string provider, string model, long maxInputTokens, int maxOutputTokens,
+        long inputRate, long cacheRate, long cacheWriteRate, long outputRate,
+        int maxPromptBytes, int maxImageBytes, int maxResponseBytes, int deadlineMilliseconds)
+    {
+        Id = id; Provider = provider; Model = model; MaxInputTokens = maxInputTokens; MaxOutputTokens = maxOutputTokens;
+        InputRate = inputRate; CacheRate = cacheRate; CacheWriteRate = cacheWriteRate; OutputRate = outputRate;
+        MaxPromptBytes = maxPromptBytes; MaxImageBytes = maxImageBytes; MaxResponseBytes = maxResponseBytes; DeadlineMilliseconds = deadlineMilliseconds;
+    }
+    public string Id { get; internal init; }
+    public string Provider { get; internal init; }
+    public string Model { get; internal init; }
+    public long MaxInputTokens { get; internal init; }
+    public int MaxOutputTokens { get; internal init; }
+    public long InputRate { get; internal init; }
+    public long CacheRate { get; internal init; }
+    public long CacheWriteRate { get; internal init; }
+    public long OutputRate { get; internal init; }
+    public int MaxPromptBytes { get; internal init; }
+    public int MaxImageBytes { get; internal init; }
+    public int MaxResponseBytes { get; internal init; }
+    public int DeadlineMilliseconds { get; internal init; }
+
+    public static bool IsOperation(string operation) => operation is "analyze-word" or "word-detail" or "review-translation" or "extract-words";
+
+    public static AiCostProfile Read(IConfiguration config, string provider, string model, string operation, string prompt, byte[]? image, string? mime)
+    {
+        if (config["AiSpend:PriceProfile"] != "2026-09-27-model-ceilings-v1" || !IsOperation(operation)
+            || (operation == "extract-words") != (image != null)) throw new AiSpendDeniedException("profile");
+        int Limit(string key, int maximum)
+        {
+            if (!int.TryParse(config["AiSpend:" + key], out var value) || value <= 0 || value > maximum)
+                throw new AiSpendDeniedException("profile_limits");
+            return value;
+        }
+        var output = Limit("MaxOutputTokens", 65536);
+        var promptLimit = Limit("MaxPromptBytes", 64000);
+        var imageLimit = Limit("MaxImageBytes", 20000000);
+        var responseLimit = Limit("MaxResponseBytes", 4000000);
+        var deadline = Limit("DeadlineMilliseconds", 60000);
+        if (string.IsNullOrWhiteSpace(prompt) || System.Text.Encoding.UTF8.GetByteCount(prompt) > promptLimit
+            || image != null && (image.Length == 0 || image.Length > imageLimit || mime is not ("image/jpeg" or "image/png" or "image/webp" or "image/heic")))
+            throw new AiSpendDeniedException("input_limit");
+        // Full model ceilings bound text AND image inputs without guessing byte/token equivalence.
+        // OpenAI: base input/cache/write/output × long-context × regional × fast envelope.
+        // Gemini: priority text/image envelope. Both requests explicitly select standard processing.
+        // Provenance and assumptions: docs/ai-provider-spend.md (2026-09-27 official sources).
+        return (provider, model) switch
+        {
+            ("OpenAI", "gpt-6-luna") => new("2026-09-27-model-ceilings-v1", provider, model, 1050000, output, 440, 44, 550, 1650,
+                promptLimit, imageLimit, responseLimit, deadline),
+            ("Gemini", "gemini-2.5-flash") => new("2026-09-27-model-ceilings-v1", provider, model, 1048576, output, 540, 54, 540, 4500,
+                promptLimit, imageLimit, responseLimit, deadline),
+            _ => throw new AiSpendDeniedException("unknown_model")
+        };
+    }
+    public long ReservationMicroUsd => checked((checked(MaxInputTokens * Math.Max(InputRate, Math.Max(CacheRate, CacheWriteRate)))
+        + checked((long)MaxOutputTokens * OutputRate) + 999) / 1000);
+}
diff --git a/src/Mavrylo.Services/Services/AiProviderTransport.cs b/src/Mavrylo.Services/Services/AiProviderTransport.cs
new file mode 100644
index 0000000000000000000000000000000000000000..19c42de51f14474936144324928481b65e8d3864
--- /dev/null
+++ b/src/Mavrylo.Services/Services/AiProviderTransport.cs
@@ -0,0 +1,107 @@
+using System.Net;
+using System.Text.Json;
+
+namespace Mavrylo.Services;
+
+/// <summary>The single reserved, non-retrying HTTP boundary for both paid adapters.</summary>
+public sealed class AiProviderTransport(IHttpClientFactory clients, IAiSpendGuard guard, AiSpendContext context, IAiSpendEvents events)
+{
+    public const string ClientName = "ai-provider-single-attempt";
+
+    public static SocketsHttpHandler CreateHandler() => new()
+    {
+        AllowAutoRedirect = false, UseProxy = false, Credentials = null, PreAuthenticate = false,
+        AutomaticDecompression = DecompressionMethods.None, UseCookies = false,
+        ConnectTimeout = TimeSpan.FromSeconds(10), MaxResponseHeadersLength = 32, MaxResponseDrainSize = 0
+    };
+
+    public async Task<JsonDocument> SendAsync(AiCostProfile profile, string operation, HttpRequestMessage request, CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested();
+        var subject = context.Subject ?? throw new AiSpendDeniedException("missing_context");
+        if (request.Method != HttpMethod.Post || request.Content == null) throw new AiSpendDeniedException("transport_shape");
+        // Pinned .NET 10 HTTP/1 path: non-null POST, no Expect/redirect/proxy/auth negotiation.
+        // Do not relax this without revalidating the loopback retry tests and runtime source.
+        request.Version = HttpVersion.Version11;
+        request.VersionPolicy = HttpVersionPolicy.RequestVersionExact;
+        request.Headers.ExpectContinue = false;
+        using var deadline = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        deadline.CancelAfter(profile.DeadlineMilliseconds);
+        SpendReservation? reservation;
+        try
+        {
+            reservation = await guard.TryReserveAsync(new(Guid.NewGuid(), subject, operation, profile, profile.ReservationMicroUsd), deadline.Token);
+        }
+        catch (OperationCanceledException) when (deadline.IsCancellationRequested && !ct.IsCancellationRequested)
+        { throw new AiSpendDeniedException("provider_deadline"); }
+        catch (OperationCanceledException) { throw; }
+        catch (Exception) { throw new AiSpendDeniedException("ledger_unavailable"); }
+        if (reservation == null) throw new AiSpendDeniedException("budget_or_concurrency");
+        AiAttemptUsage? usage = null;
+        try
+        {
+            deadline.Token.ThrowIfCancellationRequested();
+            events.Record("provider_attempt", profile.Provider);
+            using var response = await clients.CreateClient(ClientName).SendAsync(request, HttpCompletionOption.ResponseHeadersRead, deadline.Token);
+            if (!response.IsSuccessStatusCode)
+                throw new AiProviderException(profile.Provider, "Provider request failed.", (int)response.StatusCode);
+            if (response.Content.Headers.ContentLength > profile.MaxResponseBytes) throw new AiProviderException(profile.Provider, "Provider response exceeds limit.");
+            await using var stream = await response.Content.ReadAsStreamAsync(deadline.Token);
+            using var buffer = new MemoryStream();
+            var block = new byte[8192];
+            while (true)
+            {
+                var count = await stream.ReadAsync(block.AsMemory(0, Math.Min(block.Length, profile.MaxResponseBytes - (int)buffer.Length + 1)), deadline.Token);
+                if (count == 0) break;
+                if (buffer.Length + count > profile.MaxResponseBytes) throw new AiProviderException(profile.Provider, "Provider response exceeds limit.");
+                buffer.Write(block, 0, count);
+            }
+            deadline.Token.ThrowIfCancellationRequested();
+            var document = JsonDocument.Parse(buffer.ToArray());
+            usage = ReadUsage(profile.Provider, document.RootElement);
+            return document;
+        }
+        catch (OperationCanceledException ex) when (!ct.IsCancellationRequested
+            && (deadline.IsCancellationRequested || ex.InnerException is TimeoutException))
+        {
+            // .NET's separate ConnectTimeout uses OCE with an inner TimeoutException.
+            // Both provider timers are terminal unavailability; caller cancellation still propagates.
+            throw new AiSpendDeniedException("provider_deadline");
+        }
+        finally
+        {
+            // A client disconnect cannot erase a potential bill. Settlement has its own bounded token.
+            using var settlementDeadline = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+            try { await guard.CompleteAsync(reservation.Id, usage, settlementDeadline.Token); }
+            catch (Exception) { events.Record("settlement_failed_retained", profile.Provider); }
+        }
+    }
+
+    internal static AiAttemptUsage? ReadUsage(string provider, JsonElement root)
+    {
+        try
+        {
+            static long Number(JsonElement item, string name) => item.GetProperty(name).GetInt64();
+            // These two Gemini proto3 scalars omit zero on the wire. Present malformed values remain unknown.
+            static long GeminiZeroComponent(JsonElement item, string name) => item.TryGetProperty(name, out var value) ? value.GetInt64() : 0;
+            if (provider == "OpenAI")
+            {
+                var u = root.GetProperty("usage");
+                var input = u.GetProperty("input_tokens_details");
+                return new(root.GetProperty("model").GetString()!, root.GetProperty("service_tier").GetString()!,
+                    Number(u, "input_tokens"), Number(u, "output_tokens"), Number(u.GetProperty("output_tokens_details"), "reasoning_tokens"),
+                    Number(input, "cached_tokens"), Number(input, "cache_write_tokens"), Number(u, "total_tokens"));
+            }
+            var usage = root.GetProperty("usageMetadata");
+            var reasoning = GeminiZeroComponent(usage, "thoughtsTokenCount");
+            return new(root.GetProperty("modelVersion").GetString()!, usage.GetProperty("serviceTier").GetString()!,
+                Number(usage, "promptTokenCount"), checked(Number(usage, "candidatesTokenCount") + reasoning), reasoning,
+                GeminiZeroComponent(usage, "cachedContentTokenCount"), 0, Number(usage, "totalTokenCount"));
+        }
+        catch (Exception ex) when (ex is KeyNotFoundException or InvalidOperationException or FormatException or OverflowException)
+        {
+            // Missing required fields or malformed values are unknown, not a measured zero-cost response.
+            return null;
+        }
+    }
+}
diff --git a/src/Mavrylo.Services/Services/AiRequestContextReader.cs b/src/Mavrylo.Services/Services/AiRequestContextReader.cs
new file mode 100644
index 0000000000000000000000000000000000000000..738ed75bdac3f74e4d84ef46e37ea6d06bd17940
--- /dev/null
+++ b/src/Mavrylo.Services/Services/AiRequestContextReader.cs
@@ -0,0 +1,121 @@
+using System.Text;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.Mvc.Formatters;
+using Microsoft.AspNetCore.Mvc.ModelBinding;
+using Microsoft.Extensions.Options;
+using Mavrylo.Dtos;
+
+namespace Mavrylo.Services;
+
+/// <summary>Reads the same endpoint DTO and serializer options as MVC, before any usage is spent.
+/// Never rewrites the body: request proof and subsequent MVC binding use the original bytes.</summary>
+public static class AiRequestContextReader
+{
+    public sealed record WordContext(string Word, string? NativeLanguage, string? LearningLanguage);
+
+    public static async Task<WordContext> ReadAsync(byte[] body, string operation, HttpContext http)
+    {
+        var requestType = operation switch
+        {
+            "analyze-word" => typeof(AnalyzeWordRequest),
+            "word-detail" => typeof(WordDetailRequest),
+            "review-translation" => typeof(ReviewTranslationRequest),
+            _ => throw new InvalidOperationException("unsupported AI operation")
+        };
+        var metadata = http.RequestServices.GetRequiredService<IModelMetadataProvider>().GetMetadataForType(requestType);
+        var input = new InputFormatterContext(http, "", new ModelStateDictionary(), metadata,
+            (stream, encoding) => new StreamReader(stream, encoding));
+        var formatter = http.RequestServices.GetRequiredService<IOptions<MvcOptions>>().Value.InputFormatters
+            .OfType<SystemTextJsonInputFormatter>().FirstOrDefault(candidate => candidate.CanRead(input));
+        var encoding = formatter is null ? null : new EncodingSelector(formatter.SupportedEncodings).Select(input);
+        if (formatter is null || encoding is null)
+            throw new UnsupportedContentTypeException("unsupported AI JSON content type or charset");
+
+        if (encoding.CodePage == Encoding.UTF8.CodePage)
+            return Read(body, requestType, formatter.SerializerOptions);
+
+        // MVC transcodes supported non-UTF-8 encodings. Do the same on a separate copy:
+        // never replace the original stream/bytes used for binding and App Attest proof.
+        try
+        {
+            using var source = new MemoryStream(body, writable: false);
+            await using var transcoded = Encoding.CreateTranscodingStream(source, encoding, Encoding.UTF8);
+            using var interpretation = new MemoryStream();
+            await transcoded.CopyToAsync(interpretation, http.RequestAborted);
+            return Read(interpretation.ToArray(), requestType, formatter.SerializerOptions);
+        }
+        catch (DecoderFallbackException)
+        {
+            throw new InvalidOperationException("invalid AI JSON encoding");
+        }
+    }
+
+    // MVC exposes encoding selection as protected; this adapter reuses that implementation
+    // with the actual JSON formatter's supported encodings instead of duplicating its rules.
+    private sealed class EncodingSelector : TextInputFormatter
+    {
+        public EncodingSelector(IEnumerable<Encoding> encodings)
+        {
+            foreach (var encoding in encodings) SupportedEncodings.Add(encoding);
+        }
+        public Encoding? Select(InputFormatterContext context) => SelectCharacterEncoding(context);
+        public override Task<InputFormatterResult> ReadRequestBodyAsync(InputFormatterContext context, Encoding encoding)
+            => throw new NotSupportedException("This adapter only selects request encoding");
+    }
+
+    private static WordContext Read(byte[] body, Type requestType, JsonSerializerOptions options)
+    {
+        try
+        {
+            // Stream parsing accepts the optional UTF-8 BOM, like MVC's stream deserializer.
+            using var interpretation = new MemoryStream(body, writable: false);
+            using var document = JsonDocument.Parse(interpretation, new JsonDocumentOptions
+            {
+                AllowTrailingCommas = options.AllowTrailingCommas,
+                CommentHandling = options.ReadCommentHandling,
+                MaxDepth = options.MaxDepth
+            });
+            if (document.RootElement.ValueKind != JsonValueKind.Object)
+                throw new InvalidOperationException("JSON object is required");
+            var names = new HashSet<string>(options.PropertyNameCaseInsensitive ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal);
+            foreach (var property in document.RootElement.EnumerateObject())
+                if (!names.Add(property.Name))
+                    throw new InvalidOperationException("duplicate JSON property");
+
+            WordContext context;
+            string? secondary = null;
+            var review = false;
+            var request = document.RootElement.Deserialize(requestType, options);
+            switch (request)
+            {
+                case AnalyzeWordRequest analyze:
+                    context = new(analyze.Word, analyze.NativeLanguage, analyze.LearningLanguage);
+                    break;
+                case WordDetailRequest detail:
+                    context = new(detail.Word, detail.NativeLanguage, detail.LearningLanguage);
+                    secondary = detail.SecondaryLanguage;
+                    break;
+                case ReviewTranslationRequest translation:
+                    context = new(translation.Word, translation.NativeLanguage, translation.LearningLanguage);
+                    secondary = translation.SecondaryLanguage;
+                    review = true;
+                    break;
+                default:
+                    throw new InvalidOperationException("unsupported AI operation");
+            }
+            if (!WordAiService.TryValidateWordRequest(context.Word, context.NativeLanguage, context.LearningLanguage,
+                    out var native, out _, out var error))
+                throw new InvalidOperationException(error);
+            if (review && (string.IsNullOrWhiteSpace(context.NativeLanguage) || string.IsNullOrWhiteSpace(context.LearningLanguage)))
+                throw new InvalidOperationException("native and learning languages are required");
+            if ((review || secondary != null) && !WordAiService.TryValidateSecondaryLanguage(secondary, native, out _, out error))
+                throw new InvalidOperationException(error);
+            return context;
+        }
+        catch (JsonException)
+        {
+            throw new InvalidOperationException("invalid AI JSON request");
+        }
+    }
+}
diff --git a/src/Mavrylo.Services/Services/AiSpendContext.cs b/src/Mavrylo.Services/Services/AiSpendContext.cs
new file mode 100644
index 0000000000000000000000000000000000000000..278bb89db48da0e9b7da2f0cfd90de0707f50186
--- /dev/null
+++ b/src/Mavrylo.Services/Services/AiSpendContext.cs
@@ -0,0 +1,22 @@
+namespace Mavrylo.Services;
+
+public sealed record AiSpendSubject
+{
+    internal AiSpendSubject(string kind, string reference) { Kind = kind; Reference = reference; }
+    public string Kind { get; }
+    public string Reference { get; }
+}
+
+/// <summary>Set only by the accepted authorization filters, never from request input alone.</summary>
+public sealed class AiSpendContext(IHttpContextAccessor accessor)
+{
+    private static readonly object GrantKey = new();
+    public AiSpendSubject? Subject => accessor.HttpContext?.Items[GrantKey] as AiSpendSubject;
+
+    // These references identify today's authenticated principal/key, NOT immutable purchase owners.
+    public static void AuthorizeAcceptedRequest(HttpContext http, string? account, string? authenticatedKey = null)
+    {
+        if (!string.IsNullOrWhiteSpace(account)) http.Items[GrantKey] = new AiSpendSubject("account", account);
+        else if (!string.IsNullOrWhiteSpace(authenticatedKey)) http.Items[GrantKey] = new AiSpendSubject("guest", authenticatedKey);
+    }
+}
