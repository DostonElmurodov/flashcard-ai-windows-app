+using Mavrylo.Services;
+using Microsoft.AspNetCore.Http;
+using Microsoft.Extensions.Configuration;
+
+namespace Mavrylo.Tests.TestSupport;
+
+internal static class AiSpendTestSupport
+{
+    public static IConfiguration Config(Dictionary<string, string?>? overrides = null)
+    {
+        var values = new Dictionary<string, string?>
+        {
+            ["AiSpend:Enabled"] = "true", ["AiSpend:GlobalMicroUsd"] = "10000000", ["AiSpend:GuestMicroUsd"] = "10000000",
+            ["AiSpend:AccountMicroUsd"] = "10000000", ["AiSpend:MaxConcurrentAttempts"] = "20",
+            ["AiSpend:PriceProfile"] = "2026-09-27-model-ceilings-v1", ["AiSpend:MaxOutputTokens"] = "512",
+            ["AiSpend:MaxPromptBytes"] = "16000", ["AiSpend:MaxImageBytes"] = "1024", ["AiSpend:MaxResponseBytes"] = "16000",
+            ["AiSpend:DeadlineMilliseconds"] = "1000", ["OpenAI:ApiKey"] = "synthetic-key", ["Gemini:ApiKey"] = "synthetic-key"
+        };
+        if (overrides != null) foreach (var item in overrides) values[item.Key] = item.Value;
+        return TestConfig.Create(values);
+    }
+
+    public static AiProviderTransport Transport(HttpClient client, IAiSpendGuard? guard = null, bool trusted = true, IAiSpendEvents? events = null)
+    {
+        var http = new DefaultHttpContext();
+        if (trusted) AiSpendContext.AuthorizeAcceptedRequest(http, null, "server-authenticated-key");
+        return new(new FakeHttpClientFactory(client), guard ?? new RecordingGuard(),
+            new AiSpendContext(new HttpContextAccessor { HttpContext = http }), events ?? new AiSpendGuardTests.Events());
+    }
+
+    internal sealed class RecordingGuard : IAiSpendGuard
+    {
+        public bool Deny { get; set; }
+        public List<AiAttempt> Attempts { get; } = [];
+        public List<AiAttemptUsage?> Completions { get; } = [];
+        public Task<SpendReservation?> TryReserveAsync(AiAttempt attempt, CancellationToken ct)
+        {
+            Attempts.Add(attempt);
+            return Task.FromResult<SpendReservation?>(Deny ? null : new(attempt.AttemptId, attempt.UpperBoundMicroUsd));
+        }
+        public Task CompleteAsync(Guid reservationId, AiAttemptUsage? usage, CancellationToken ct) { Completions.Add(usage); return Task.CompletedTask; }
+    }
+}
