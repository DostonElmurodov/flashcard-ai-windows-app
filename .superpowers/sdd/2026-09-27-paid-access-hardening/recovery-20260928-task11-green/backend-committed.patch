+name: API validation
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v4
+      - name: Record tested source
+        run: git rev-parse HEAD
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '10.0.x'
