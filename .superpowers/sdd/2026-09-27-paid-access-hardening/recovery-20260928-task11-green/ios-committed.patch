+
+    func text(_ sql: String) throws -> String? {
+        try database.withDB { handle in
+            var statement: OpaquePointer?
+            guard sqlite3_prepare_v2(handle, sql, -1, &statement, nil) == SQLITE_OK else {
+                throw LocalDatabaseError.prepareFailed(String(cString: sqlite3_errmsg(handle)))
+            }
+            defer { sqlite3_finalize(statement) }
+            guard sqlite3_step(statement) == SQLITE_ROW, let value = sqlite3_column_text(statement, 0) else { return nil }
+            return String(cString: value)
+        }
+    }
+
+    func populatePrimaryCache() throws {
+        try database.withDB { handle in
+            let sql = #"UPDATE words SET word_detail_json = '{"translations":["Saved translation","Saved alternative"],"translation":"Saved translation"}';"#
+            guard sqlite3_exec(handle, sql, nil, nil, nil) == SQLITE_OK else {
+                throw LocalDatabaseError.execFailed(String(cString: sqlite3_errmsg(handle)))
+            }
+        }
+    }
+
+    func waitForSyncCount(_ count: Int) async {
+        for _ in 0..<50 {
+            if (try? text("SELECT CAST(COUNT(*) AS TEXT) FROM device_word_sync_state;")) == String(count) { return }
+            try? await Task.sleep(nanoseconds: 100_000_000)
+        }
+        XCTFail("Local fake sync did not finish before fixture cleanup")
+    }
+
+    func cleanup() async {
+        guard !cleanedUp else { return }
+        cleanedUp = true
+        closingDatabase = database
+        repository = nil
+        database = nil
+        for _ in 0..<50 {
+            if closingDatabase == nil { break }
+            try? await Task.sleep(nanoseconds: 100_000_000)
+        }
+        // Awaited teardown keeps fake callbacks inside their originating test.
+        XCTAssertNil(closingDatabase, "Fixture database remained open; preserved directory instead of unlinking SQLite")
+        if closingDatabase == nil { try? FileManager.default.removeItem(at: directory) }
+        EntitlementStore.shared.update(previousEntitlement)
+        for key in Self.keys {
+            if let value = previousDefaults[key] { UserDefaults.standard.set(value, forKey: key) }
+            else { UserDefaults.standard.removeObject(forKey: key) }
+        }
+        MutationNoNetworkProtocol.responseData = nil
+    }
+}
+
+private final class MutationOneShot: @unchecked Sendable {
+    private let lock = NSLock()
+    private var hasRun = false
+    func run(_ body: () -> Void) {
+        lock.lock()
+        let shouldRun = !hasRun
+        hasRun = true
+        lock.unlock()
+        if shouldRun { body() }
+    }
+}
+
+private final class MutationUpsertCapture: @unchecked Sendable {
+    private let lock = NSLock()
+    private var accepted = false
+    private var captured: [DeviceWordUpsertAPIRequest] = []
+    var acceptsSave: Bool {
+        get { lock.lock(); defer { lock.unlock() }; return accepted }
+        set { lock.lock(); accepted = newValue; lock.unlock() }
+    }
+
+    var requests: [DeviceWordUpsertAPIRequest] { lock.lock(); defer { lock.unlock() }; return captured }
+    func record(_ request: DeviceWordUpsertAPIRequest) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        captured.append(request)
+        return accepted
+    }
+}
