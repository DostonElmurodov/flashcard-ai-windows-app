+final class EntitlementMutationBoundaryTests: XCTestCase {
+    @MainActor
+    func testPastExpiryCannotAuthorizeAIOrAddingForActiveStatus() {
+        ServerFeatureFlags.shared.disable()
+        for status in ["premium", "trial", "grace"] {
+            let value = entitlement(status, expiry: "2000-01-01T00:00:00Z")
+            XCTAssertFalse(FreeLimitPolicy.canUseAI(entitlement: value, currentWordCount: 0), status)
+            XCTAssertFalse(FreeLimitPolicy.canAddWord(entitlement: value, currentWordCount: 0), status)
+        }
+    }
+
+    @MainActor
+    func testMissingOrMalformedExpiryCannotAuthorizePremiumMutations() {
+        ServerFeatureFlags.shared.disable()
+        let expiries: [String?] = [nil, "not-a-date", ""]
+        for expiry in expiries {
+            let value = entitlement("premium", expiry: expiry)
+            XCTAssertFalse(FreeLimitPolicy.canUseAI(entitlement: value, currentWordCount: 0))
+            XCTAssertFalse(FreeLimitPolicy.canAddWord(entitlement: value, currentWordCount: 0))
+        }
+    }
+
+    @MainActor
+    func testFutureVerifiedGuestPurchaseDoesNotRequireAnOwlAccount() {
+        ServerFeatureFlags.shared.disable()
+        withStore { store, defaults in
+            store.update(entitlement("premium", expiry: "2099-01-01T00:00:00Z"))
+            XCTAssertTrue(store.canUseAI)
+            XCTAssertTrue(store.allowsAddingWords)
+            let relaunched = EntitlementStore(defaults: defaults)
+            XCTAssertFalse(relaunched.canUseAI, "Paid mutation confirmation cannot be resurrected by a snapshot")
+            XCTAssertTrue(FreeLimitPolicy.isWordActive(entitlement: relaunched.entitlement, zeroBasedIndex: 100))
+        }
+    }
+
+    @MainActor
+    func testExpiredGuestSnapshotCannotRegainMutationRightsOnOfflineRelaunch() {
+        withStore { store, defaults in
+            store.update(entitlement("premium", expiry: "2000-01-01T00:00:00.123Z"))
+            XCTAssertFalse(store.canUseAI)
+            XCTAssertFalse(store.allowsAddingWords)
+            let relaunched = EntitlementStore(defaults: defaults)
+            XCTAssertFalse(relaunched.canUseAI)
+            XCTAssertFalse(relaunched.allowsAddingWords)
+        }
+    }
+
+    @MainActor
+    func testFreshInvalidLinkedProjectionCannotManufacturePaidHistoryOnRelaunch() {
+        withStore { store, defaults in
+            store.update(entitlement("premium", expiry: "2099-01-01T00:00:00Z"))
+            store.markDevicePurchaseLinked()
+            store.update(entitlement("invalid_subscription", expiry: nil, paid: false, linked: true))
+            XCTAssertTrue(defaults.bool(forKey: "FlashCardAI.entitlement.linkedPurchase"), "Preserve ownership protection")
+            XCTAssertEqual(store.entitlement.status, "invalid_subscription")
+            XCTAssertFalse(store.entitlement.wasEverPaid, "A linked marker is not validated paid history")
+            XCTAssertFalse(store.canUseAI)
+            let relaunched = EntitlementStore(defaults: defaults)
+            XCTAssertEqual(relaunched.entitlement.status, "invalid_subscription")
+            XCTAssertFalse(relaunched.entitlement.wasEverPaid)
+            XCTAssertFalse(relaunched.allowsAddingWords)
+        }
+    }
+
+    @MainActor
+    func testFreshRevokedLinkedProjectionCannotBecomeOrdinaryPaidRetention() {
+        withStore { store, defaults in
+            store.update(entitlement("revoked", expiry: "2000-01-01T00:00:00Z", linked: true))
+            XCTAssertEqual(store.entitlement.status, "revoked")
+            XCTAssertFalse(FreeLimitPolicy.isWordActive(entitlement: store.entitlement, zeroBasedIndex: 10))
+            XCTAssertEqual(EntitlementStore(defaults: defaults).entitlement.status, "revoked")
+        }
+    }
+
+    @MainActor
+    func testInactiveUnvalidatedAndFreeSnapshotsRetainOnlyOldestTenForReview() {
+        ServerFeatureFlags.shared.disable()
+        for status in ["free", "expired_trial", "revoked", "invalid_subscription", "future_status"] {
+            let value = entitlement(status, expiry: nil, paid: false)
+            XCTAssertTrue(FreeLimitPolicy.isWordActive(entitlement: value, zeroBasedIndex: 9), status)
+            XCTAssertFalse(FreeLimitPolicy.isWordActive(entitlement: value, zeroBasedIndex: 10), status)
+            XCTAssertTrue(FreeLimitPolicy.locksWordsBeyondFreeLimit(status: status), status)
+        }
+    }
+
+    @MainActor
+    func testOrdinaryPaidExpiryPreservesAllSavedReviewButBlocksMutations() {
+        ServerFeatureFlags.shared.disable()
