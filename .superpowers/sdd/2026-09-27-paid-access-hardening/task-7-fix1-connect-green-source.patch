diff --git a/tests/AiProviderTransportTests.cs b/tests/AiProviderTransportTests.cs
index 004852b..8c46f37 100644
--- a/tests/AiProviderTransportTests.cs
+++ b/tests/AiProviderTransportTests.cs
@@ -11,6 +11,23 @@ namespace Mavrylo.Tests;
 
 public class AiProviderTransportTests(PostgresContainerFixture postgres) : IClassFixture<PostgresContainerFixture>
 {
+    [Fact]
+    public async Task CallerCancellationDuringConnectionStaysCancellation()
+    {
+        using var handler = AiProviderTransport.CreateHandler();
+        var started = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        handler.ConnectCallback = async (_, ct) => { started.SetResult(); await Task.Delay(Timeout.Infinite, ct); return Stream.Null; };
+        using var client = new HttpClient(handler) { Timeout = Timeout.InfiniteTimeSpan };
+        var guard = new AiSpendTestSupport.RecordingGuard(); var transport = AiSpendTestSupport.Transport(client, guard);
+        var profile = AiCostProfile.Read(AiSpendTestSupport.Config(new() { ["AiSpend:DeadlineMilliseconds"] = "5000" }), "Gemini", "gemini-2.5-flash", "word-detail", "prompt", null, null);
+        using var caller = new CancellationTokenSource();
+        using var request = new HttpRequestMessage(HttpMethod.Post, "http://127.0.0.1/") { Content = new StringContent("{}") };
+        var attempt = transport.SendAsync(profile, "word-detail", request, caller.Token);
+        await started.Task.WaitAsync(TimeSpan.FromSeconds(2)); caller.Cancel();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => attempt);
+        Assert.Single(guard.Attempts); Assert.Null(Assert.Single(guard.Completions));
+    }
+
     [Theory]
     [InlineData("disconnect")]
     [InlineData("redirect")]
diff --git a/tests/AiSpendRouteTests.cs b/tests/AiSpendRouteTests.cs
index d4f82e1..34f0b15 100644
--- a/tests/AiSpendRouteTests.cs
+++ b/tests/AiSpendRouteTests.cs
@@ -15,6 +15,49 @@ namespace Mavrylo.Tests;
 
 public class AiSpendRouteTests(PostgresContainerFixture postgres) : IClassFixture<PostgresContainerFixture>
 {
+    [Theory]
+    [InlineData("OpenAI")]
+    [InlineData("Gemini")]
+    public async Task HandlerConnectDeadlineReturnsUnavailableOverHttpAndRetainsReservation(string provider)
+    {
+        var connections = 0; var alerts = new AiProviderBoundaryTests.NoAlert();
+        var config = AiSpendTestSupport.Config(new() { ["AI:Provider"] = provider, ["AiSpend:DeadlineMilliseconds"] = "5000" }).AsEnumerable().ToDictionary(x => x.Key, x => x.Value);
+        config["TestMode:Enabled"] = "true"; config["AiProtection:RequireAssertion"] = "false";
+        await using var factory = new ApiFactory(postgres.ConnectionString, services =>
+        {
+            // Keep the actual named-client handler; replace only connection establishment, with no remote sockets.
+            services.Configure<Microsoft.Extensions.Http.HttpClientFactoryOptions>(AiProviderTransport.ClientName, options =>
+                options.HttpMessageHandlerBuilderActions.Add(builder =>
+                {
+                    var handler = Assert.IsType<SocketsHttpHandler>(builder.PrimaryHandler);
+                    Assert.Equal(TimeSpan.FromSeconds(10), handler.ConnectTimeout);
+                    handler.ConnectTimeout = TimeSpan.FromMilliseconds(80);
+                    handler.ConnectCallback = async (_, ct) =>
+                    {
+                        Interlocked.Increment(ref connections);
+                        await Task.Delay(Timeout.Infinite, ct);
+                        return Stream.Null;
+                    };
+                }));
+            services.RemoveAll<IDevAlertEmailService>(); services.AddSingleton<IDevAlertEmailService>(alerts);
+        }, config);
+        factory.UseKestrel(0);
+        using var client = await AuthorizedClient(factory, true);
+        using var scope = factory.Services.CreateScope(); var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        var beforeCount = await db.AiSpendReservations.CountAsync();
+        var beforePending = await db.AiSpendBuckets.Where(x => x.Id == "global").Select(x => x.PendingAttempts).SingleOrDefaultAsync();
+        using var response = await Post(client, "/owlai/account/ai/word-detail", "word-detail", Guid.NewGuid().ToString("N"), CancellationToken.None);
+        Assert.Equal(HttpStatusCode.ServiceUnavailable, response.StatusCode);
+        using var body = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        Assert.Equal("ai_translation_unavailable", body.RootElement.GetProperty("error").GetString());
+        Assert.Equal(1, connections); Assert.Equal(0, alerts.Calls);
+        Assert.Equal(beforeCount + 1, await db.AiSpendReservations.CountAsync());
+        var row = await db.AiSpendReservations.AsNoTracking().OrderByDescending(x => x.CreatedAt).FirstAsync();
+        Assert.Equal(provider, row.Provider); Assert.Null(row.SettledAt);
+        Assert.Equal(provider == "Gemini" ? 568536 : 578345, row.ChargedMicroUsd);
+        Assert.Equal(beforePending + 1, (await db.AiSpendBuckets.AsNoTracking().SingleAsync(x => x.Id == "global")).PendingAttempts);
+    }
+
     [Theory]
     [InlineData("OpenAI", "analyze-word")]
     [InlineData("Gemini", "word-detail")]
