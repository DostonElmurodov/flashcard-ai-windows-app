+            case "missing_candidates": usage.Remove("candidatesTokenCount"); break;
+            case "missing_model": body.Remove("modelVersion"); break;
+            case "missing_tier": usage.Remove("serviceTier"); break;
+            case "unknown_model": body["modelVersion"] = "unknown"; break;
